{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "rewriteRelativeImportExtensions": true,
    "types": [
      "node",
      "bun"
    ],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "runpod/**/*.ts",
    "verda/**/*.ts",
    "*.ts"
  ]
}
